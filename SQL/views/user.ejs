<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
</head>
<body>
    <style>
        table, th, td {
            border: 1px solid black;
        } 
    </style>
    <table>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Username</th>
        </tr>
        <% users.forEach(user => { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.username %></td>
            <td>
                <form method="GET" action="/user/<%= user.id %>/edit">
                    <button type="submit">Edit Username</button>
                </form>
            </td>
        </tr>
        <% }); %>
    </table>
</body>
</html>