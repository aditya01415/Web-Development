<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PATCH">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" value="<%= listing.title %>" required><br><br>
        <label for="description">Description:</label>
        <textarea name="description" id="description" required><%= listing.description %></textarea><br><br>
        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" value="<%= listing.image %>" required><br><br>
        <button type="submit">Update Listing</button>
    </form>
</body>
</html>