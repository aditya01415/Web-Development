<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8" offset-2>
    <h3>Edit Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PATCH" novalidate class="needs-validation">
        <div class="mb-3">
        <label for="title">Title:</label>
        <input type="text" class="form-control" name="title" id="title" value="<%= listing.title %>" required>
        </div>
        <div class="mb-3">
        <label for="description">Description:</label>
        <textarea name="description" class="form-control" id="description" required><%= listing.description %></textarea>
        </div>
        <div class="mb-3">
        <label for="image">Image URL:</label>
        <input type="text" class="form-control" name="image" id="image" value="<%= listing.image %>" required>
        </div>

        <div class="row">
            <div class="mb-3 col-4">
                <label for="price">Price:</label>
                <input type="number" class="form-control" name="price" id="price" value="<%= listing.price %>" required>
            </div>
            <div class="mb-3 col-8">
                <label for="country">Country:</label>
                <input type="text" class="form-control" name="country" id="country" value="<%= listing.country %>" required>
            </div>
        </div>
        <div class="mb-3">
        <label for="location">Location:</label>
        <input type="text" class="form-control" name="location" id="location" value="<%= listing.location %>" required>
        </div>
        <button type="submit" class="btn btn-dark edit-btn mt-3 ">Update Listing</button>
    </form>
    </div>
    </div>
    <script src="/JS/script.js"></script>
