<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Chats</title>
</head>
<body>
    <h3>Edit Your Chats</h3>
    <p>This chat was sent from <i><%= chat.from %></i> to <i><%= chat.to %></i></p>

    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" rows="10" cols="50"><%= chat.msg %></textarea>
        <br> <br>
        <button>Edit Chat</button>
    </form>
</body>
</html>