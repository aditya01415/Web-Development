<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write New Chats</title>
</head>
<body>
    <h3>Write New Chats</h3>
    <form method="POST" action="/chats">
        <input placeholder="who are you?" name="from">
        <br> <br>
        <textarea placeholder="write your message here" name="msg"></textarea>
        <br> <br>
        <input placeholder="who do you want to send to?" name="to">
        <br> <br>
        <button >Create Chat</button>
    </form>
</body>
</html>